# PostgreSQL connection. Matches docker-compose.yml in the repository root.
DATABASE_URL=postgresql+psycopg://boosta:boosta@localhost:5432/boosta

# Separate database used by the test suite (its tables are dropped and rebuilt).
TEST_DATABASE_URL=postgresql+psycopg://boosta:boosta@localhost:5432/boosta_test

# Origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
